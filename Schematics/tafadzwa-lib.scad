//======================================================
// NODE 1 DETACHABLE LID
//======================================================

//======================================================
// SETTINGS
//======================================================

wall = 3;

box_length = 170;
box_width  = 120;

lid_height = 10;

corner = 5;

//======================================================
// LID
//======================================================

difference(){

    //--------------------------------------------------
    // OUTER LID
    //--------------------------------------------------

    roundedBox(box_length, box_width, lid_height, corner);

    //--------------------------------------------------
    // INNER HOLLOW
    //--------------------------------------------------

    translate([wall,wall,wall])

    roundedBox(
        box_length-wall*2,
        box_width-wall*2,
        lid_height,
        corner-1
    );

    //--------------------------------------------------
    // LCD WINDOW
    //--------------------------------------------------

    translate([50,-1,3])
    cube([70,6,25]);

    //--------------------------------------------------
    // GREEN LED HOLE
    //--------------------------------------------------

    translate([38,-1,15])
    rotate([90,0,0])
    cylinder(h=6,d=5,$fn=30);

    //--------------------------------------------------
    // RED LED HOLE
    //--------------------------------------------------

    translate([132,-1,15])
    rotate([90,0,0])
    cylinder(h=6,d=5,$fn=30);
}

//======================================================
// MODULES
//======================================================

module roundedBox(l,w,h,r){

    hull(){

        translate([r,r,0])
        cylinder(r=r,h=h,$fn=40);

        translate([l-r,r,0])
        cylinder(r=r,h=h,$fn=40);

        translate([r,w-r,0])
        cylinder(r=r,h=h,$fn=40);

        translate([l-r,w-r,0])
        cylinder(r=r,h=h,$fn=40);
    }
}